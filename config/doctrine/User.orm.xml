<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <mapped-superclass name="Rapsys\UserBundle\Entity\User" repository-class="Rapsys\UserBundle\Repository\UserRepository">
    <id name="id" type="integer" column="id">
		<generator strategy="AUTO" />
		<options>
		  <option name="unsigned">true</option>
		</options>
    </id>
	<field name="mail" type="string" length="254" unique="true" />
	<field name="forename" type="string" length="32" nullable="true" />
	<field name="surname" type="string" length="32" nullable="true" />
	<field name="password" type="string" length="100" nullable="true" />
	<field name="active" type="boolean">
      <options>
        <option name="default">true</option>
      </options>
	</field>
	<field name="enable" type="boolean">
      <options>
        <option name="default">true</option>
      </options>
	</field>
	<field name="created" type="datetime" />
	<field name="updated" type="datetime" />
	<many-to-one field="civility" target-entity="Rapsys\UserBundle\Entity\Civility" inversed-by="users" fetch="LAZY" />
	<many-to-many field="groups" target-entity="Rapsys\UserBundle\Entity\Group" inversed-by="users" fetch="LAZY" />
	<lifecycle-callbacks>
      <lifecycle-callback type="preUpdate" method="preUpdate" />
    </lifecycle-callbacks>
  </mapped-superclass>
</doctrine-mapping>
