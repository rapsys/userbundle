<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <!--<entity name="Rapsys\UserBundle\Entity\Civility" table="civilities">-->
  <mapped-superclass name="Rapsys\UserBundle\Entity\Civility">
    <id name="id" type="integer" column="id">
		<generator strategy="AUTO" />
		<options>
		  <option name="unsigned">true</option>
		</options>
    </id>
	<field name="title" type="string" length="16" />
	<field name="created" type="datetime" />
	<field name="updated" type="datetime" />
    <one-to-many field="users" target-entity="Rapsys\UserBundle\Entity\User" mapped-by="civility" fetch="LAZY"/>
	<lifecycle-callbacks>
      <lifecycle-callback type="preUpdate" method="preUpdate" />
    </lifecycle-callbacks>
  </mapped-superclass>
</doctrine-mapping>
